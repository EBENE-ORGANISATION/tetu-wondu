# Copiez ce fichier en « .env » et remplacez les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# La clé « anon public ». Elle est PUBLIQUE par nature : elle part dans le
# navigateur de chaque visiteur, c'est prévu. Ce sont les règles de sécurité
# de la base (RLS) qui protègent les données, pas le secret de cette clé.
# Ne jamais confondre avec la clé « service_role », qui ne doit JAMAIS
# apparaître ici ni nulle part dans ce projet.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Le nom affiché de la marque. Changer le nom du site = changer cette ligne.
VITE_APP_NAME=TETU WONDU

# L'adresse publique du site, pour construire les liens partagés sur WhatsApp.
# En développement, laisser l'adresse locale.
VITE_SITE_URL=http://localhost:5173
